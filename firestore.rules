rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Keamanan TeleBunda AI (PRD Bab 7 & UAT Bab 13):
    // Semua akses baca dan tulis langsung dari klien Flutter ditolak.
    // Seluruh mutasi data profil, slot, booking, chat, dan hasil konsultasi
    // wajib melalui REST API Laravel yang menggunakan Firebase Admin SDK.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
